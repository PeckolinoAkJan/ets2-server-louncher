<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VTC-Truck-Hub-Launcher</AssemblyName>
    <RootNamespace>VtcTruckHub.Launcher</RootNamespace>
    <Version>0.10.1</Version>
    <ApplicationIcon>Assets\VtcTruckHub.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\VtcTruckHub.png" />
    <Resource Include="Assets\VtcTruckHub.ico" />
  </ItemGroup>
</Project>
