<Window x:Class="VtcTruckHub.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VTC Truck Hub" Width="1120" Height="720" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F5F5">
 <Grid><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition/><RowDefinition Height="78"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,3"><Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="🚛" FontSize="45"/><StackPanel Margin="12,0"><TextBlock Text="VTC TRUCK HUB" FontSize="28" FontWeight="Bold"/><TextBlock Text="COMMUNITY LAUNCHER" Foreground="{StaticResource Accent}" FontWeight="Bold"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Name="AccountText" Text="Nicht angemeldet" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0"><StackPanel Margin="14,28"><Button Content="▶  SPIELEN" Height="52" HorizontalContentAlignment="Left" Background="#F8E9EA" Foreground="{StaticResource Accent}" BorderThickness="0"/><Button Content="▣  EVENTS" Height="52" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"/><Button Content="☁  VERSIONEN" Height="52" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"/><Button Content="⚙  EINSTELLUNGEN" Height="52" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"/></StackPanel></Border>
   <Grid Grid.Column="1" Margin="34,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Willkommen beim VTC Truck Hub" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Spiel auswählen, sicher mit Steam anmelden und danach dem VTC-Server beitreten." Foreground="#666" FontSize="15" Margin="0,7,0,22"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Margin="0,0,10,0" CornerRadius="8" Background="#152631" Padding="28"><StackPanel VerticalAlignment="Center"><TextBlock Text="EURO TRUCK SIMULATOR 2" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="Europa · Standardkarte und ProMods" Foreground="#B8CBD5"/><TextBlock Text="🚚" FontSize="105" HorizontalAlignment="Center" Margin="0,30"/><TextBlock Name="EtsState" Foreground="#54D96B" HorizontalAlignment="Center"/></StackPanel></Border><Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="8" Background="#633820" Padding="28"><StackPanel VerticalAlignment="Center"><TextBlock Text="AMERICAN TRUCK SIMULATOR" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="USA · Standardkarte und ProMods" Foreground="#E1C5B4"/><TextBlock Text="🚛" FontSize="105" HorizontalAlignment="Center" Margin="0,30"/><TextBlock Name="AtsState" Foreground="#54D96B" HorizontalAlignment="Center"/></StackPanel></Border></Grid><Border Name="ConnectionPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0" Padding="14" Background="#E8F7ED" BorderBrush="#25B96A" BorderThickness="1" CornerRadius="6"><TextBlock Name="ConnectionText" TextWrapping="Wrap" Foreground="#166C38" FontWeight="SemiBold"/></Border></Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0"><Grid Margin="25,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="360"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Name="StatusText" Text="Launcher wird vorbereitet …" Foreground="#25B96A" VerticalAlignment="Center" FontWeight="Bold"/><Button Name="UpdateButton" Visibility="Collapsed" Margin="14,0,0,0" Content="UPDATE" Background="#25B96A" Foreground="White" BorderThickness="0"/></StackPanel><ComboBox Name="GameSelect" Grid.Column="1" Height="48" Margin="12,0" VerticalContentAlignment="Center"><ComboBoxItem Tag="ets2" IsSelected="True">Euro Truck Simulator 2</ComboBoxItem><ComboBoxItem Tag="ats">American Truck Simulator</ComboBoxItem></ComboBox><Button Name="PlayButton" Grid.Column="2" Content="▶  SPIELEN" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" FontSize="16"/></Grid></Border>
 </Grid>
</Window>
