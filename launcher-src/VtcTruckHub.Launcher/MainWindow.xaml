<Window x:Class="VtcTruckHub.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VTC Truck Hub Multiplayer" Width="1420" Height="850" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#071018" Foreground="#F3F7F5">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#0D1720"/><SolidColorBrush x:Key="Panel2" Color="#111D27"/><SolidColorBrush x:Key="Line" Color="#22313C"/><SolidColorBrush x:Key="Green" Color="#50D86A"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#101B24"/><Setter Property="Foreground" Value="#E9F0ED"/><Setter Property="BorderBrush" Value="#2B3B46"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="54"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="54"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="276"/><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Background="#09131B" BorderBrush="#182630" BorderThickness="0,0,1,0"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="190"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="60" Height="60" CornerRadius="14" BorderBrush="#50D86A" BorderThickness="2"><TextBlock Text="🚛" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,7,0,0"><TextBlock Text="VTC TRUCK HUB" FontSize="19" FontWeight="Bold"/><TextBlock Text="MULTIPLAYER" Foreground="{StaticResource Green}" FontSize="12" FontWeight="Bold"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="1"><Button Name="HomeNav" Style="{StaticResource Nav}" Background="#152128" BorderBrush="#50D86A" BorderThickness="0,0,3,0" Content="⌂   Startseite"/><Button Name="ServersNav" Style="{StaticResource Nav}" Content="◎   Server"/><Button Name="ModsNav" Style="{StaticResource Nav}" Content="✚   Mods"/><Button Name="NewsNav" Style="{StaticResource Nav}" Content="▤   Neuigkeiten"/><Separator Background="#25323B" Margin="0,12"/><Button Name="SettingsNav" Style="{StaticResource Nav}" Content="⚙   Einstellungen"/><Button Name="AccountNav" Style="{StaticResource Nav}" Content="♙   Konto"/></StackPanel>
    <Border Grid.Row="3" CornerRadius="12" Background="#0E1922" BorderBrush="#253640" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="Gemeinsam fahren." Foreground="{StaticResource Green}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Gemeinsam wachsen." Foreground="{StaticResource Green}" FontSize="19"/><TextBlock Margin="0,13,0,0" TextWrapping="Wrap" Foreground="#A7B5BC" Text="VTC Truck Hub verbindet Fahrer, Server und den deutschen Ingame-Dispatcher in einem Client."/></StackPanel></Border>
   </Grid></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="34,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="24"/><RowDefinition Height="310"/></Grid.RowDefinitions>
    <TextBlock Text="SPIEL AUSWÄHLEN" Foreground="#91A0A8" FontSize="12" FontWeight="SemiBold"/>
    <Grid Grid.Row="1" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border CornerRadius="13" BorderBrush="#50D86A" BorderThickness="2" Margin="0,0,9,0" Background="#102832"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#163E48"/><GradientStop Color="#071116" Offset="1"/></LinearGradientBrush></Grid.Background><StackPanel Margin="28"><TextBlock Text="EURO TRUCK" FontSize="28" FontWeight="Bold"/><TextBlock Text="SIMULATOR 2" FontSize="28" FontWeight="Bold"/><TextBlock Text="Europa · Standardkarte und ProMods" Foreground="#B9C7CC" Margin="0,10"/><TextBlock Text="🚚" FontSize="70" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal"><TextBlock Text="✓" Foreground="{StaticResource Green}" FontSize="20"/><TextBlock Name="EtsState" Margin="8,2" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid></Border>
     <Border Grid.Column="1" CornerRadius="13" BorderBrush="#3B4145" BorderThickness="1" Margin="9,0,0,0" Background="#281B14"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#56301E"/><GradientStop Color="#0B1014" Offset="1"/></LinearGradientBrush></Grid.Background><StackPanel Margin="28"><TextBlock Text="AMERICAN TRUCK" FontSize="28" FontWeight="Bold"/><TextBlock Text="SIMULATOR" FontSize="28" FontWeight="Bold"/><TextBlock Text="USA · Standardkarte und ProMods" Foreground="#C9BEB8" Margin="0,10"/><TextBlock Text="🚛" FontSize="70" HorizontalAlignment="Right"/><TextBlock Name="AtsState" Foreground="#B9C2C7"/></StackPanel></Grid></Border>
    </Grid>
    <Border Grid.Row="3" CornerRadius="13" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition/><RowDefinition Height="64"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{StaticResource Green}" Margin="0,0,10,0"/><TextBlock Text="EMPFOHLENER SERVER" Foreground="#9FADB4" FontWeight="SemiBold"/></StackPanel>
     <Border Grid.Row="1" CornerRadius="10" Background="#14232D" BorderBrush="#293A44" BorderThickness="1"><Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Border CornerRadius="10" Background="#071116"><TextBlock Text="VTC" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Green}"/></Border><StackPanel Grid.Column="1" Margin="22,8"><TextBlock Text="VTC Truck Hub | Europa 1" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="●  Online" Foreground="{StaticResource Green}" Margin="0,9"/><TextBlock Text="Realistische Community · eigener Multiplayer · Dispatcher" Foreground="#AAB8BF"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><TextBlock Text="SPIELER  " Foreground="#82939C"/><TextBlock Text="0 / 128" FontWeight="Bold"/><TextBlock Text="     KARTENPROFIL  " Foreground="#82939C"/><TextBlock Text="Standard / ProMods" FontWeight="Bold"/></StackPanel></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="NETZWERK" Foreground="#82939C" HorizontalAlignment="Center"/><TextBlock Text="VTC Native" Foreground="{StaticResource Green}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="TLS · Steam-Konto" Foreground="#82939C" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
     <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="200"/><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><Button Name="PlayButton" Background="#39B94E" BorderBrush="#65E379" FontSize="16" Content="▶  SERVER STARTEN &amp; BEITRETEN"/><Button Grid.Column="1" Margin="12,0" Content="♙  SERVERLISTE"/><ComboBox Name="GameSelect" Grid.Column="3" Background="#101B24" Foreground="White" BorderBrush="#30414B" Padding="12"><ComboBoxItem Tag="ets2" IsSelected="True">Euro Truck Simulator 2</ComboBoxItem><ComboBoxItem Tag="ats">American Truck Simulator</ComboBoxItem></ComboBox></Grid>
    </Grid></Border>
    <Border Name="ConnectionPanel" Grid.Row="3" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="20" Padding="12" Background="#163B25" BorderBrush="#50D86A" BorderThickness="1" CornerRadius="6"><TextBlock Name="ConnectionText" TextWrapping="Wrap" Foreground="#8EF09F"/></Border>
   </Grid></ScrollViewer>
   <StackPanel Grid.Column="2" Margin="0,22,20,22">
    <Border CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="23" Background="#27343C"><TextBlock Text="◉" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,2"><TextBlock Text="●  Steam verbunden" Foreground="{StaticResource Green}" FontSize="12"/><TextBlock Name="AccountText" Text="Nicht angemeldet" FontSize="17" FontWeight="SemiBold"/></StackPanel></Grid></Border>
    <Border Margin="0,18,0,0" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="MULTIPLAYER-STATUS" Foreground="#9EADB5" FontSize="12"/><TextBlock Text="VTC-Netzwerk bereit" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock Text="Spielerzustände, TAB-Dispatcher und Sitzungen werden verschlüsselt über den VTC-Server synchronisiert." TextWrapping="Wrap" Foreground="#9EADB5"/><Separator Background="#263640" Margin="0,18"/><TextBlock Text="SCHNELLZUGRIFF" Foreground="#9EADB5" FontSize="12"/><Button Margin="0,12,0,0" HorizontalContentAlignment="Left" Content="◎   Server durchsuchen"/><Button Margin="0,8,0,0" HorizontalContentAlignment="Left" Content="✚   Mods verwalten"/><Button Margin="0,8,0,0" HorizontalContentAlignment="Left" Content="▤   Serverregeln"/><Button Margin="0,8,0,0" HorizontalContentAlignment="Left" Content="?   Support"/></StackPanel></Border>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#0A141C" BorderBrush="#1D2B34" BorderThickness="0,1,0,0"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Fill="{StaticResource Green}"/><TextBlock Name="StatusText" Margin="9,0" Text="Launcher wird vorbereitet …" Foreground="#B7C3C8"/></StackPanel><TextBlock Grid.Column="1" Text="VTC Truck Hub Multiplayer" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#84949C"/><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Name="UpdateButton" Visibility="Collapsed" Content="⟳  UPDATE"/><TextBlock Text="  ✓ Bereit" Foreground="{StaticResource Green}" VerticalAlignment="Center"/></StackPanel></Grid></Border>
 </Grid>
</Window>
